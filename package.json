{
  "name": "dsh-session-slime",
  "version": "0.2.0",
  "description": "Colorful slimes in the DSH sidebar that act out each conversation's status (running / waiting for approval / done / idle).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "slime",
    "session"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mousewangyongliang/dsh-session-slime.git"
  },
  "homepage": "https://github.com/mousewangyongliang/dsh-session-slime#readme",
  "bugs": {
    "url": "https://github.com/mousewangyongliang/dsh-session-slime/issues"
  }
}
